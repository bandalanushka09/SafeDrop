PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/safedrop
USE_MEMORY_DB=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_VILLAGE=

# Optional geocoding (defaults to OpenStreetMap Nominatim)
GEOCODING_API_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=
GEOCODING_USER_AGENT=SafeDrop/1.0 (rural-water-safety)

# Official government reporting. Leave empty unless a real API is available.
GOVERNMENT_API_URL=
GOVERNMENT_API_KEY=
GOVERNMENT_API_SECRET=
GOVERNMENT_STATUS_URL=

# Optional email confirmation
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
