{
  "name": "safedrop-root",
  "version": "1.0.0",
  "description": "SafeDrop - Safe Water. Healthy Villages.",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm run install:server && npm run install:client",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "seed:admin": "npm --prefix server run seed:admin",
    "seed:demo": "npm --prefix server run seed:demo",
    "test": "npm --prefix server test"
  }
}

